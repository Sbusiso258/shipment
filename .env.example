# Shipment Oversight — environment
#
# Copy this file to `.env.local` and fill it in. `.env.local` is gitignored;
# this file is committed and must never contain a real value.
#
# ---------------------------------------------------------------------------
# A note on NEXT_PUBLIC_
# ---------------------------------------------------------------------------
# Anything prefixed NEXT_PUBLIC_ is inlined into the JavaScript bundle and is
# readable by anyone who opens the site. That is correct for both values below
# and correct for nothing else.
#
# The Supabase anon key is *designed* to be public. It grants no privileges by
# itself — every rule about who may read or write a row is enforced by Row
# Level Security in the database.
#
# There is NO service-role key in this project, and there must never be one.
# A service-role key bypasses RLS entirely, so a single one leaking into the
# bundle would expose every organisation's shipments to every visitor. If you
# ever find yourself wanting one, the policy is wrong, not the key.
# ---------------------------------------------------------------------------

# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Map tiles
# ---------------------------------------------------------------------------
# MapLibre consumes a style URL and nothing in the app knows where tiles come
# from, so this one variable is the whole upgrade path: point it at MapTiler,
# Protomaps or a self-hosted tileserver and no component changes.
#
# OpenFreeMap needs no key, no quota and no billing account, and places no
# restriction on commercial use. Leave it as-is unless you have a reason.
#
# Unset it and the journey view falls back to the SVG route schematic, which
# plots the same real coordinates with no external dependency at all.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# ---------------------------------------------------------------------------
# Verification accounts (optional; used only by `npm run verify:rls`)
# ---------------------------------------------------------------------------
# verify:rls signs in as real users in two different organisations and asserts
# that neither can see the other's shipments. Without these it SKIPs loudly
# rather than passing quietly — a tenancy check that silently does nothing is
# worse than no check, because it reports green.
#
# Create these as ordinary users in your Supabase dashboard, give them
# memberships in two different test organisations, and never point them at
# real customer data.

VERIFY_ORG_A_ADMIN_EMAIL=
VERIFY_ORG_A_ADMIN_PASSWORD=
VERIFY_ORG_B_VIEWER_EMAIL=
VERIFY_ORG_B_VIEWER_PASSWORD=

# ---------------------------------------------------------------------------
# Applying migrations to the live project
# ---------------------------------------------------------------------------
# Only needed to run `npm run db:check` and `npm run db:run`, which apply a SQL
# file to the live database over a direct Postgres connection. The app itself
# never reads this: nothing in src/ imports it, and it is not a way around
# row-level security — it is a psql substitute on a machine with no psql.
#
# Supabase dashboard -> Settings -> Database -> Connection string.
# Take "Session pooler" if this machine has no IPv6, otherwise "Direct
# connection". Replace [YOUR-PASSWORD] with the database password.
#
# THIS STRING IS THE DATABASE PASSWORD. It belongs in .env.local, which is
# gitignored. Never paste it into a chat, a commit or a shell command.
SUPABASE_DB_URL=
